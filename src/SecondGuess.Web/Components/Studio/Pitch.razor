@using System.Globalization
@using SecondGuess.Simulation

@*
    The whole pitch at the frozen moment, landscape like a broadcast tactical camera, drawn like a broadcast telestrator.
    Coordinates are metres from the acting team's perspective (attacking towards x = 105).
    The decision actually taken is a dashed blue line. After an answer, the option being discussed is drawn:
    marker yellow if it was better than what happened, chalk white if it was worse.
*@

<figure class="pitch" aria-label="@Summary">
    <svg viewBox="-3 -2.5 111 73" role="img" xmlns="http://www.w3.org/2000/svg">
        <title>@Summary</title>

        @* Turf with mowing stripes *@
        <rect x="0" y="0" width="105" height="68" class="turf" />
        @for (int i = 0; i < 12; i++)
        {
            if (i % 2 == 0)
            {
                <rect x="@F(i * 8.75)" y="0" width="8.75" height="68" class="stripe" />
            }
        }

        @* Markings for both halves: touchlines, halfway line, centre circle, penalty areas, six-yard boxes, spots, arcs, goals *@
        <g class="lines">
            <rect x="0" y="0" width="105" height="68" />
            <line x1="52.5" y1="0" x2="52.5" y2="68" />
            <circle cx="52.5" cy="34" r="9.15" />
            <circle cx="52.5" cy="34" r="0.3" class="spot" />

            <rect x="88.5" y="13.84" width="16.5" height="40.32" />
            <rect x="99.5" y="24.84" width="5.5" height="18.32" />
            <circle cx="94" cy="34" r="0.3" class="spot" />
            <path d="M 88.5 26.69 A 9.15 9.15 0 0 0 88.5 41.31" />
            <rect x="105" y="30.34" width="2" height="7.32" class="goal" />

            <rect x="0" y="13.84" width="16.5" height="40.32" />
            <rect x="0" y="24.84" width="5.5" height="18.32" />
            <circle cx="11" cy="34" r="0.3" class="spot" />
            <path d="M 16.5 26.69 A 9.15 9.15 0 0 1 16.5 41.31" />
            <rect x="-2" y="30.34" width="2" height="7.32" class="goal" />
        </g>

        @if (State is not null && Result is not null)
        {
            var ball = new Point2(State.BallX, State.BallY);

            @* The decision that was taken *@
            @if (Result.ActualAction == "shot")
            {
                var shotEnd = ShotEnd();
                <line x1="@F(ball.X)" y1="@F(ball.Y)" x2="@F(shotEnd.X)" y2="@F(shotEnd.Y)" class="actual" />
                @if (State.Moment.Outcome == "goal")
                {
                    <circle cx="@F(shotEnd.X)" cy="@F(shotEnd.Y)" r="0.8" class="outcome-dot" />
                }
                else
                {
                    <line x1="@F(shotEnd.X)" y1="@F(shotEnd.Y - 1.3)" x2="@F(shotEnd.X)" y2="@F(shotEnd.Y + 1.3)" class="outcome-bar" />
                }
                @OutcomeLabel(shotEnd.X, shotEnd.Y, State.Moment.Outcome)
            }
            else if (FindPlayer(Result.Actual.TargetPlayerName) is { } actualTarget)
            {
                <line x1="@F(ball.X)" y1="@F(ball.Y)" x2="@F(actualTarget.X)" y2="@F(actualTarget.Y)" class="actual" />
            }

            @* The option being discussed, drawn when an answer arrives *@
            @if (Drawn is { } drawn)
            {
                string tone = DrawnIsBetter ? "marker" : "marker worse";
                @if (drawn.Kind == "pass" && FindPlayer(drawn.TargetPlayerName) is { } receiver)
                {
                    <path @key="@($"{Result.EventId}-{drawn.Key}-pass")" class="@tone"
                          d="M @F(ball.X) @F(ball.Y) L @F(receiver.X) @F(receiver.Y)" pathLength="1" />
                    <path @key="@($"{Result.EventId}-{drawn.Key}-finish")" class="@tone finish"
                          d="M @F(receiver.X) @F(receiver.Y) L 105 34" pathLength="1" />
                    <circle cx="@F(receiver.X)" cy="@F(receiver.Y)" r="2.6" class="ring @(DrawnIsBetter ? "" : "worse")" />
                }
                else if (drawn.Kind == "carry")
                {
                    var end = CarryEnd(ball);
                    <path @key="@($"{Result.EventId}-{drawn.Key}-carry")" class="@tone"
                          d="M @F(ball.X) @F(ball.Y) L @F(end.X) @F(end.Y)" pathLength="1" />
                }
            }

            @* Players *@
            @foreach (var p in State.Players)
            {
                bool isActor = p.Name == Result.PlayerName;
                bool isTarget = Drawn?.TargetPlayerName == p.Name;
                <g class="player @TeamClass(p.TeamName) @(isActor ? "actor" : "")">
                    <title>@PlayerTooltip(p, isActor, isTarget)</title>
                    <circle cx="@F(p.X)" cy="@F(p.Y)" r="1.25" />
                    @if (isActor || (isTarget && ShowAlternative))
                    {
                        @NameLabel(p.X, p.Y - 2.2, Surname(p.Name))
                    }
                </g>
            }

            <circle cx="@F(ball.X)" cy="@F(ball.Y)" r="0.65" class="ball" />
        }
    </svg>

    @if (Result is not null)
    {
        <figcaption>
            <span class="tag actual-tag">@ActionLabel(Result.Actual) <strong>@Pct(Result.Actual.MeanValue)</strong></span>
            @if (Drawn is { } d)
            {
                <span class="tag @(DrawnIsBetter ? "best-tag" : "worse-tag")">@ActionLabel(d) <strong>@Pct(d.MeanValue)</strong></span>
            }
            @if (ShowAlternative && RightCall && (Drawn is null || !DrawnIsBetter))
            {
                <span class="tag right-call-tag">The right call</span>
            }
            <span class="key">
                <span class="home">@HomeTeamName</span>
                <span class="away">@AwayTeamName</span>
                <span class="line-actual">What happened</span>
                @if (Drawn is not null)
                {
                    <span class="@(DrawnIsBetter ? "line-best" : "line-worse")">@(DrawnIsBetter ? "Better option" : "Worse option")</span>
                }
            </span>
        </figcaption>
    }
</figure>

@code {
    [Parameter] public GameState? State { get; set; }
    [Parameter] public WhatIfResult? Result { get; set; }

    /// <summary>The alternative is drawn only once the agents have answered, so the reveal lands with the answer.</summary>
    [Parameter] public bool ShowAlternative { get; set; }

    /// <summary>The option the viewer's question was about, if it named one. Otherwise the best alternative is drawn.</summary>
    [Parameter] public string? FocusKey { get; set; }

    [Parameter] public string HomeTeamName { get; set; } = "";
    [Parameter] public string AwayTeamName { get; set; } = "";

    private readonly record struct Point2(double X, double Y);

    /// <summary>True when nothing would have been better than what the player did.</summary>
    private bool RightCall => Result is not null && OptionFocus.ActualWasBest(Result);

    /// <summary>
    /// The option to draw: the one the question asked about, otherwise the best alternative,
    /// but never a "better option" when the player already made the right call.
    /// </summary>
    private OptionResult? Drawn
    {
        get
        {
            if (!ShowAlternative || Result is null) return null;
            if (FocusKey is not null && Result.Options.FirstOrDefault(o => o.Key == FocusKey && !o.IsActual) is { } focus) return focus;
            return RightCall ? null : Result.BestAlternative;
        }
    }

    private bool DrawnIsBetter => Drawn is { } d && Result is not null && d.MeanValue > Result.Actual.MeanValue;

    private string Summary => Result is null
        ? "Football pitch"
        : $"{Result.PlayerName} at {Result.MatchClock}: {ActionLabel(Result.Actual)} {Pct(Result.Actual.MeanValue)}" +
          (Drawn is { } d ? $"; {(DrawnIsBetter ? "better" : "worse")} option {ActionLabel(d)} {Pct(d.MeanValue)}" : "") +
          (ShowAlternative && RightCall && !DrawnIsBetter ? "; the right call" : "");

    private PlayerSnapshot? FindPlayer(string? name) =>
        name is null ? null : State?.Players.FirstOrDefault(p => p.Name == name);

    private string TeamClass(string teamName) => teamName == HomeTeamName ? "home" : "away";

    /// <summary>Where the shot really ended. Saved shots end at the goalkeeper who saved them.</summary>
    private Point2 ShotEnd()
    {
        double x = State?.EndX ?? 105, y = State?.EndY ?? 34;
        if (State?.Moment.Outcome != "saved") return new Point2(x, y);

        var keeper = State!.Players.FirstOrDefault(p => !p.IsTeammate && p.Position == "GK");
        if (keeper is null) return new Point2(Math.Min(x, 103.2), y);

        // Stop just in front of the keeper, on the side the ball came from.
        double dx = keeper.X - State.BallX, dy = keeper.Y - State.BallY, d = Math.Sqrt(dx * dx + dy * dy);
        return d < 2 ? new Point2(keeper.X, keeper.Y) : new Point2(keeper.X - dx / d * 1.6, keeper.Y - dy / d * 1.6);
    }

    private static MarkupString OutcomeLabel(double x, double y, string? outcome)
    {
        string text = outcome switch
        {
            "goal" => "Goal",
            "saved" => "Saved",
            "blocked" => "Blocked",
            "off_target" => "Wide",
            _ => ""
        };
        if (text == "") return new MarkupString("");

        // Place the label inside the pitch, just in front of where the shot ended.
        double labelX = Math.Min(x - 1.5, 101.5);
        double labelY = y < 34 ? y - 1.8 : y + 3.2;
        return new($"<text x=\"{F(labelX)}\" y=\"{F(labelY)}\" class=\"outcome-label\">{text}</text>");
    }

    private static Point2 CarryEnd(Point2 ball)
    {
        double dx = 105 - ball.X, dy = 34 - ball.Y, d = Math.Sqrt(dx * dx + dy * dy);
        double step = Math.Min(6, Math.Max(d - 6, 0));
        return d == 0 ? ball : new Point2(ball.X + dx / d * step, ball.Y + dy / d * step);
    }

    private static string ActionLabel(OptionResult o) => o.Kind switch
    {
        "shot" => "Shot",
        "carry" => "Carry and shoot",
        _ => $"Pass to {Surname(o.TargetPlayerName ?? "")}"
    };

    private string PlayerTooltip(PlayerSnapshot p, bool isActor, bool isTarget)
    {
        string who = $"{p.Name} ({p.Position}), {p.TeamName}";
        if (isActor) return $"{who}: on the ball, {Outcome()}";
        string distance = $"{F(p.DistanceToBallMetres)} m from the ball";
        if (!isTarget || Drawn is null) return $"{who}: {distance}";
        return DrawnIsBetter ? $"{who}: better pass option, {distance}" : $"{who}: pass option (worse than what happened), {distance}";
    }

    private string Outcome() => Result?.ActualAction switch
    {
        "shot" => "took the shot",
        "pass" => "made the pass",
        "carry" => "carried the ball",
        _ => "made the decision"
    };

    private static string Surname(string name) => name.Contains(' ') ? name[(name.LastIndexOf(' ') + 1)..] : name;

    private static string Pct(double v) => (v * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    // SVG <text> can't be written directly inside Razor code blocks (Razor reserves the <text> tag), so it is emitted as markup.
    private static MarkupString NameLabel(double x, double y, string name) =>
        new($"<text x=\"{F(x)}\" y=\"{F(y)}\" class=\"name\">{System.Net.WebUtility.HtmlEncode(name)}</text>");
}
